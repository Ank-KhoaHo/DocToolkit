# Verifies the whole stack really is Linux-safe with no native dependencies.
#
# TWO images, and both are needed. The projects multi-target net8.0;net10.0. The 8.0 SDK cannot
# BUILD a net10.0 target (NETSDK1045), and the 10.0 SDK image cannot RUN the net8.0 half of the
# suite, because it ships no .NET 8 runtime:
#
#   Testhost process for source(s) '.../net8.0/DocToolkit.Tests.dll' exited with error:
#   You must install or update .NET to run this application.
#
# An earlier version of this comment claimed the 10.0 SDK "covers the full matrix". It does not -
# building and running are different questions, and nothing caught the difference because nothing
# ran this file. The first CI run of ci.yml's `linux container build & test` job found it
# immediately.
#
# Copying the shared framework out of the official runtime image is the documented way to get
# side-by-side runtimes: it needs no second install step and no network fetch during the build, and
# the two directories merge because each runtime lives in its own version-named subdirectory.
FROM mcr.microsoft.com/dotnet/runtime:8.0 AS dotnet8

# The SDK is pinned to the exact version global.json requires, not the floating 10.0 tag.
# rollForward is latestPatch, which does NOT cross feature bands - so a floating tag that moved from
# 10.0.3xx to 10.0.4xx would start failing here with "a compatible .NET SDK was not found". Bump
# this and global.json together.
#
# The runtime above is deliberately NOT pinned that way. Any 8.0.x runs a net8.0 assembly, and
# ci.yml installs `8.0.x` for the same reason - pinning it would add a version to keep in step for
# no determinism this repository actually needs.
FROM mcr.microsoft.com/dotnet/sdk:10.0.302

COPY --from=dotnet8 /usr/share/dotnet/shared/Microsoft.NETCore.App /usr/share/dotnet/shared/Microsoft.NETCore.App

WORKDIR /src

# global.json and the root Directory.Build.props are NOT optional here.
#
# src/Directory.Build.props imports the root one by walking up the tree, so without it MSBuild
# fails outright, and every property that moved out of the csproj files - Nullable, ImplicitUsings,
# LangVersion, TreatWarningsAsErrors - is simply absent. Omitting global.json is quieter and worse:
# the build silently uses whatever SDK the image carries, which is the drift this file was pinned
# to remove.
#
# This is not hypothetical. The props file arrived and this COPY list was not updated, so the
# documented Linux check was broken for a day and nothing said so - because, at the time, nothing
# ran it. ci.yml's `linux container build & test` job now does, on every push and pull request, so
# an incomplete COPY list fails a check instead of waiting to be noticed. Keep it that way: this
# file is only worth having if something runs it.
COPY global.json Directory.Build.props DocToolkit.sln ./
COPY src/ ./src/
COPY tests/ ./tests/
COPY samples/ ./samples/

RUN dotnet restore DocToolkit.sln
CMD ["dotnet", "test", "DocToolkit.sln", "--logger", "console;verbosity=normal"]
