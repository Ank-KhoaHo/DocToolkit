<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocToolkit.Extensions.DependencyInjection\DocToolkit.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <!--
    Copied to the output directory rather than found by walking up from the test assembly: that
    walk-up depth changes with configuration and TFM, so it breaks depending on how the tests were
    invoked. An intended API change means editing the file HERE and rebuilding, not the copy.
  -->
  <ItemGroup>
    <Content Include="PublicApi\*.approved.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Linked from the core test project rather than duplicated, the way sample.pptx already is. These
    are real Word 97-2003 binaries produced by Word itself; a second copy of a binary fixture is a
    second thing to keep in step, and the pair is meaningless unless both files stay exactly what
    they are - legacy.doc holds a table and therefore CANNOT convert without an opt-in, while
    legacy-lossless.doc can.
  -->
  <ItemGroup>
    <Content Include="..\DocToolkit.Tests\assets\sample.pptx" Link="assets\sample.pptx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DocToolkit.Tests\assets\legacy.doc" Link="assets\legacy.doc" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DocToolkit.Tests\assets\legacy-lossless.doc" Link="assets\legacy-lossless.doc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
