<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
    <!--
      ApiSurface.cs (linked in below) programs directly against Mono.Cecil's ModuleDefinition -
      needs a direct reference of its own rather than relying on the transitive one
      PublicApiGenerator's nuspec happens to declare. Pinned to the exact version
      PublicApiGenerator 11.5.4 depends on; bump together.
    -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocToolkit.Extensions.DependencyInjection\DocToolkit.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <!--
    Copied to the output directory rather than found by walking up from the test assembly: that
    walk-up depth changes with configuration and TFM, so it breaks depending on how the tests were
    invoked. An intended API change means editing the file HERE and rebuilding, not the copy.
  -->
  <ItemGroup>
    <Content Include="PublicApi\*.approved.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    LINKED, not copied. The generation half of the approval tests has to be one implementation:
    it carries the reason the assembly is read from a symbol-free copy, which is not obvious and
    was learned expensively (B30). The comparison and the report wording stay per-project,
    because the two say deliberately different things about what an ADDED member means.
  -->
  <ItemGroup>
    <Compile Include="..\DocToolkit.Tests\ApiSurface.cs" Link="ApiSurface.cs" />
  </ItemGroup>

  <!--
    Linked from the core test project rather than duplicated, the way sample.pptx already is. These
    are real Word 97-2003 binaries produced by Word itself; a second copy of a binary fixture is a
    second thing to keep in step, and the pair is meaningless unless both files stay exactly what
    they are - legacy.doc holds a table and therefore CANNOT convert without an opt-in, while
    legacy-lossless.doc can.
  -->
  <ItemGroup>
    <Content Include="..\DocToolkit.Tests\assets\sample.pptx" Link="assets\sample.pptx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DocToolkit.Tests\assets\legacy.doc" Link="assets\legacy.doc" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DocToolkit.Tests\assets\legacy-lossless.doc" Link="assets\legacy-lossless.doc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
