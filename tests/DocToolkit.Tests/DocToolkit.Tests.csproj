<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocToolkit\DocToolkit.csproj" />
  </ItemGroup>

  <!--
    Fixture PDFs live in this project's own assets/ (not spike/out) because spike/ is
    develop-only reference material that scripts/promote-to-main.sh strips from main - a fixture
    left under spike/out would not exist there, and release.yml builds and tests this project
    against main before publishing. Living with the project that consumes them means they survive
    the strip along with tests/ itself.
    Copied into the test output dir rather than referenced via ".." walking from the test
    assembly location: that walk-up path depth changes with configuration/TFM (bin/Debug/net8.0
    vs bin/Release/net10.0 etc.), so it would be fragile across build configurations. Copying
    puts the fixture next to the test DLL every time, so AppContext.BaseDirectory + a fixed
    relative subpath resolves correctly regardless of the working directory `dotnet test` is
    invoked from.
  -->
  <ItemGroup>
    <Content Include="assets\result.pdf" Link="Fixtures\result.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\big.pdf" Link="Fixtures\big.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A real one-slide PPTX ("Hello {{who}}" in a single text box), generated once with
    ShapeCrawler before that package was removed (see PresentationEditorTests.cs). Building a
    minimal valid PPTX by hand with the raw OpenXml SDK needs presentation/master/layout/theme
    parts, so a committed real fixture is far less boilerplate than hand-rolling one.
  -->
  <ItemGroup>
    <Content Include="assets\sample.pptx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
