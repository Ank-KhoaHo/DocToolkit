{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "robots.txt"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "sitemap": {
      "baseUrl": "https://ank-khoaho.github.io/DocToolkit/",
      "priority": 0.5,
      "changefreq": "weekly"
    },
    "globalMetadata": {
      "_appName": "DocToolkit",
      "_appTitle": "DocToolkit",
      "_enableSearch": false,
      "pdf": false
    }
  }
}
