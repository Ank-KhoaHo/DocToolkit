<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared build and packaging properties live in src/Directory.Build.props. Only what differs
    between the two packages belongs here.
  -->
  <PropertyGroup>
    <PackageId>Ank.DocToolkit.Extensions.DependencyInjection</PackageId>
    <Description>
      Dependency-injection registration for Ank.DocToolkit. services.AddDocToolkit() registers
      six injectable interfaces (IHtmlToDocxConverter, IDocxToPdfConverter, IHtmlToPdfConverter,
      IDocxEditor, IWorkbookEditor, IPresentationEditor) over the same pure-managed HTML/DOCX/
      PDF/XLSX/PPTX conversion and editing logic, for ASP.NET Core and worker-service consumers.
    </Description>
    <PackageTags>docx;pdf;xlsx;pptx;dependency-injection;aspnetcore;openxml</PackageTags>
  </PropertyGroup>

  <!-- README.md, THIRD-PARTY-NOTICES.txt and the shared icon are packed by src/Directory.Build.props. -->

  <ItemGroup>
    <PackageReference Include="Ank.DocToolkit" Version="[0.11.0, )" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0, )" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="[8.0.0, )" />
  </ItemGroup>

  <!--
    Service implementations are internal sealed (never public - consumers depend on the
    interfaces only), but the test project instantiates them directly to exercise the
    delegation logic without going through the DI container. Grant that one assembly access.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DocToolkit.Extensions.DependencyInjection.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- See src/DocToolkit/DocToolkit.csproj for why this is an attribute and not <IsTrimmable>. -->
    <AssemblyMetadata Include="IsTrimmable" Value="True" />
  </ItemGroup>

</Project>
