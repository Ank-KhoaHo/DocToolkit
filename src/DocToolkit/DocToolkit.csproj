<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- NuGet package identity -->
  <PropertyGroup>
    <PackageId>Ank.DocToolkit</PackageId>
    <Version>0.1.0</Version>
    <Authors>Khoa Ho</Authors>
    <Description>
      Convert HTML to DOCX and PDF, and open/edit DOCX, XLSX and PPTX - pure managed,
      no native binaries, no browser, no LibreOffice. Runs on Linux.
    </Description>
    <PackageTags>docx;pdf;xlsx;pptx;html;openxml;document;conversion</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Ank-KhoaHo/DocToolkit</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlToOpenXml.dll" Version="3.5.0" />
    <PackageReference Include="OfficeIMO.Word.Pdf" Version="3.0.3" />

    <!--
      Pinned deliberately, not incidentally. OfficeIMO.Word asks for SixLabors.Fonts
      [1.0.0, 3.0.0), and 1.x is Apache-2.0 while 2.x moved to the Six Labors Split License 1.0 -
      Apache-2.0 only below $1M annual revenue, commercial above. Letting NuGet float to 2.x
      would silently move this package off permissive licensing, which is its whole reason to
      exist. The exact-version bracket keeps that from happening quietly; see
      THIRD-PARTY-NOTICES.txt and the DependencyGuardTests guard.
    -->
    <PackageReference Include="SixLabors.Fonts" Version="[1.0.1]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />

    <!--
      One icon, shared by both packages: they are companions that always ship at the same
      version, so two files could only ever drift. It is a committed PNG, never generated at
      build time - every convenient imaging library is either revenue-gated or carries native
      binaries, which is exactly what DependencyGuardTests exists to keep out. assets/make-icon.py
      regenerates it and is deliberately not wired into any build.
    -->
    <None Include="$(MSBuildThisFileDirectory)../../assets/icon.png" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    TableRowFinder is internal - consumers use DocxEditor, never it directly - but its one
    dangerous behaviour, refusing to reach into nested tables, fails SILENTLY when it regresses:
    the document is still schema-valid, just wrong. Proving that end-to-end shows a bad document
    without showing which rows were chosen, so the test project gets direct access.
    Same trade the extensions package already makes for its internal service implementations.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DocToolkit.Tests" />
  </ItemGroup>

</Project>
