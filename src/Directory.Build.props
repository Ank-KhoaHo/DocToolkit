<Project>

  <!--
    Shared by the two packable projects only. Imports the repository-wide file above rather than
    replacing it - MSBuild stops at the nearest Directory.Build.props, so without this import
    src/ would silently lose TreatWarningsAsErrors and ContinuousIntegrationBuild.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>


  <!--
    Package identity shared by both packages. PackageId, Description and PackageTags stay in the
    individual projects - those differ per package. Version is the local dev default only: the
    git tag is the authoritative version (see CLAUDE.md > Releasing), which is why both projects
    have always said 0.1.0 regardless of what shipped.
  -->
  <PropertyGroup>
    <Version>0.34.0</Version> <!-- x-release-please-version -->
    <Authors>Khoa Ho</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Ank-KhoaHo/DocToolkit</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Both added 2026-08-15 after auditing the PACKED .nuspec rather than this file - which is the
      only way to see what a consumer actually receives.

      PublishRepositoryUrl is what puts the repository URL into the nuspec. Without it the SDK
      still emitted <repository type="git" commit="..."/> - a commit hash with nothing saying which
      repository it belongs to, which is not a useful thing to hand somebody debugging.

      Copyright is a Microsoft "DO" and was simply absent. A package without one asserts nothing
      about its own provenance.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright (c) Khoa Ho 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Relative item paths in an imported file resolve against the PROJECT being built, not against
      this file - so each package picks up its own README.md and its own THIRD-PARTY-NOTICES.txt.
      $(MSBuildThisFileDirectory) does resolve against this file, which is why the icon path is
      written that way.

      One icon, shared by both packages: they are companions that always ship at the same version,
      so two files could only ever drift. It is a committed PNG, never generated at build time -
      every convenient imaging library is either revenue-gated or carries native binaries, which is
      exactly what DependencyGuardTests exists to keep out. assets/make-icon.py regenerates it and
      is deliberately not wired into any build.
    -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Release notes are DERIVED from the curated CHANGELOG.md, never stored here.

    Every version page on nuget.org showed an EMPTY Release Notes section, on a package that
    curates a changelog entry per release. release.yml now writes that entry to a file and passes
    its path; this reads it. Same source as the GitHub Release body, which release-please.yml
    already builds with scripts/extract-changelog-section.py - so one curated entry now reaches
    three surfaces instead of one, the same move gen-third-party-notices.py makes by reading the
    lockfile rather than keeping a table.

    A FILE PATH RATHER THAN THE TEXT, deliberately. An MSBuild property splits on semicolons, so
    passing a changelog entry on the command line would silently truncate any entry containing
    one. A path cannot contain that hazard and the file is read whole.

    BeforeTargets="GenerateNuspec" because that is the target that writes the .nuspec. Setting the
    property any later has NO effect and fails silently - the package simply packs without notes,
    exactly as it did before, which looks like success. Verified by packing and reading the
    .nuspec back rather than by reading this file.

    The condition means a local `dotnet pack` with no property packs EXACTLY as it did before.
    That negative control was run: no <releaseNotes> element at all.
  -->
  <Target Name="ReadReleaseNotesFromFile"
          BeforeTargets="GenerateNuspec"
          Condition="'$(PackageReleaseNotesFile)' != '' AND Exists('$(PackageReleaseNotesFile)')">
    <PropertyGroup>
      <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

</Project>
