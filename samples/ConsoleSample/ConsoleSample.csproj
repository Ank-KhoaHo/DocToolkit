<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Version="*" resolves to the newest published stable release, on purpose.

    This project is the external-consumer canary: it exists to prove the real
    published package works, so it must track whatever is currently newest. A
    floor like [0.3.2, ) does the opposite - NuGet resolves a minimum-version
    range to the LOWEST satisfying version, so the sample would keep building
    against 0.3.2 forever while newer releases went unexercised. That is the bug
    fixed once by bumping the floor, which then went stale again on the very next
    release.

    A floating reference also breaks the release loop that chasing it created:
    every floor bump was a merge, every merge is a release, and every release
    made the floor stale again.
  -->
  <ItemGroup>
    <PackageReference Include="Ank.DocToolkit" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tests\DocToolkit.Tests\assets\sample.pptx" Link="assets\sample.pptx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
